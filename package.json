{
  "name": "pokemon-card-pack-finder",
  "version": "1.0.0",
  "description": "This is to scrape the internet to see good prices, where to look, and click a link straight to the good stuff, if it is cards, packs, or boxes!",
  "main": "index.js",
  "scripts": {
    "start": "node server.js",
    "site": "node server.js",
    "test": "node tests/server.test.js",
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:browser\"",
    "dev:server": "nodemon server.js",
    "dev:browser": "wait-on http://localhost:3000 && browser-sync start --proxy http://localhost:3000 --files \"public/**/*\" --files \"server.js\" --port 3001 --no-open"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntonioChieffallo/Pokemon-Card-Pack-finder.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/AntonioChieffallo/Pokemon-Card-Pack-finder/issues"
  },
  "homepage": "https://github.com/AntonioChieffallo/Pokemon-Card-Pack-finder#readme",
  "dependencies": {
    "axios": "^1.14.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "browser-sync": "^3.0.4",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.14",
    "wait-on": "^9.0.4"
  }
}
